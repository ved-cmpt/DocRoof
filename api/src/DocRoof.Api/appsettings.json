{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DocRoof": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleTenant": false
  },
  "Storage": {
    "Mode": "Local",
    "LocalPath": "data/files",
    "MaxUploadBytes": 26214400
  },
  "Demo": {
    "Enabled": true,
    "TtlHours": 24,
    "MaxWorkspacesPerIpPerHour": 5,
    "MaxActiveWorkspaces": 200,
    "CleanupIntervalMinutes": 15,
    "StartPersona": "requester"
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "DemoPerHour": 10,
    "UploadPerFiveMinutes": 30,
    "ExtractionPerFiveMinutes": 20,
    "GlobalPerMinute": 600
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "MaxAttempts": 3
  }
}
