# Copy to .env (never commit .env). Values here are local-development defaults only.

# SQL Server container (docker-compose.yml) - local only, bound to 127.0.0.1:14330
MSSQL_SA_PASSWORD=DocRoof_Local_Dev_2026!

# API (ASP.NET Core reads double-underscore env vars as configuration sections).
# appsettings.Development.json already contains these local defaults; set them only to override.
# ConnectionStrings__DocRoof=Server=127.0.0.1,14330;Database=DocRoof;User Id=sa;Password=DocRoof_Local_Dev_2026!;TrustServerCertificate=True;Encrypt=True
# Database__MigrateOnStartup=true
# Database__SeedSampleTenant=true
# Intentionally public demo password for the sample workspace accounts (see SECURITY.md). Leave empty in production.
# Database__SampleUserPassword=DocRoofDemo2026
# Storage__Mode=Local
# Demo__IpHashSalt=change-me-per-deployment

# Optional extraction provider (disabled unless both are set). Rules-based extraction always works without it.
# Extraction__Provider=
# Extraction__ApiKey=
